[Unit]
Description=Ledger web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/finance/ledger
EnvironmentFile=/etc/ledger.env
ExecStart=/home/opc/finance/ledger/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5017 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
